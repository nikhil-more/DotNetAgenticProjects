{
    "name": "C# (.NET 10)",
    "image": "mcr.microsoft.com/devcontainers/dotnet:dev-10.0",
    "runArgs": [
        "--env-file",
        "${localWorkspaceFolder}/.devcontainer/.env"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.csharp"
            ]
        }
    },
    "forwardPorts": [5000, 5001],
    "remoteUser": "vscode"
}